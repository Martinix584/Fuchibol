# Copiá este archivo a .env y completá con tus datos
GCP_PROJECT_ID=tu-proyecto-gcp
GCS_BUCKET=tu-bucket-fuchibol
BQ_LOCATION=US
BQ_RAW_DATASET=raw_transfermarkt
BQ_STATSBOMB_DATASET=raw_statsbomb
BQ_UNDERSTAT_DATASET=raw_understat
BQ_SOFASCORE_DATASET=raw_sofascore
BQ_OPS_DATASET=ops
# Tablas del modelo de valor (ingestion/ml.py). dbt y el script usan el mismo dataset:
# ml con --target prod, <DBT_DEV_DATASET>_ml en dev.
# BQ_ML_DATASET=ml
# Minutos mínimos en la temporada para entrenar y predecir.
# ML_MIN_MINUTES=900
# Alcance de StatsBomb: core (348 partidos), big5_2015 (1.551), messi (866), all. Se combinan con comas.
STATSBOMB_SCOPE=core
# Understat: xG/xA de la temporada actual de las 5 grandes (big5, all o ligas separadas por coma).
UNDERSTAT_SCOPE=big5
# UNDERSTAT_SEASON=2026
# SofaScore: opcional, local/manual (Argentina + respaldo de las 5 grandes). No va en Airflow.
SOFASCORE_SCOPE=ARG
# Vacío = full (top solo trae los líderes de cada ranking: no sirve como carga principal).
# SOFASCORE_MODE=full
SOFASCORE_RATE_LIMIT_S=3
SOFASCORE_DAILY_BUDGET=1000
# SOFASCORE_SEASON=2026
# SOFASCORE_PROFILE_DIR=/home/usuario/.cache/fuchibol/sofascore-profile
# SOFASCORE_HEADLESS=true
# Segundos que espera el captcha en modo --headful antes de abortar.
# SOFASCORE_CAPTCHA_TIMEOUT_S=300
# Dataset personal para desarrollar con dbt (target dev)
DBT_DEV_DATASET=dev
# Airflow en Docker: uid de tu usuario (en Linux: id -u) para que dbt pueda escribir en ./dbt
AIRFLOW_UID=50000
# Airflow: archivo de credenciales (default ./keys/sa.json). Sin claves de SA, usá tu ADC:
# GCP_CREDENTIALS_FILE=/home/usuario/.config/gcloud/application_default_credentials.json
