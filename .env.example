# Copiá este archivo a .env y completá con tus datos
GCP_PROJECT_ID=tu-proyecto-gcp
GCS_BUCKET=tu-bucket-fuchibol
BQ_LOCATION=US
BQ_RAW_DATASET=raw_transfermarkt
BQ_STATSBOMB_DATASET=raw_statsbomb
BQ_OPS_DATASET=ops
# Alcance de StatsBomb: core (~350 partidos), big5_2015 (~1.800), messi (~520), all. Se combinan con comas.
STATSBOMB_SCOPE=core
# Dataset personal para desarrollar con dbt (target dev)
DBT_DEV_DATASET=dev
